# Optional backend environment values (set in PowerShell, do not commit real .env)
# Google Application Default Credentials must be configured for the approved project.
FRONTEND_ORIGIN=http://localhost:3000
FIREBASE_STORAGE_BUCKET=

# Optional: requires Firebase Trigger Email extension and SMTP setup.
# This only QUEUES emails; Firebase extension sends them asynchronously.
METRONOTIFY_EMAIL_ENABLED=0
METRONOTIFY_MAIL_COLLECTION=mail
